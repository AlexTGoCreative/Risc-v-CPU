# Synthesis and programming for the Terasic DE2 (Cyclone II) are done in
# Quartus; see boards/README.md. These targets exist so the top-level
# Makefile can recurse here without error.

.PHONY: all install clean

all:
	@echo "No automated FPGA build in this directory. See boards/README.md (DE2 / Quartus)."

install:
	@echo "Device programming is done from Quartus (USB Blaster). See boards/README.md."

clean:
	@:
